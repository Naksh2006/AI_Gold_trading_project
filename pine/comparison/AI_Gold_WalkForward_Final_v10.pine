    b0 := -0.01215554, p_m := 0.48908801, p_s := 0.08208371, active_fold := 3
else if time >= 1789257600000 and time < 1789516800000
    w1 := 0.02676933, w2 := 0.00231506, w3 := -0.03818356, w4 := 0.01127780
    w5 := 0.34875984, w6 := -0.54341372, w7 := -0.73742310, w8 := 0.36363137
    b0 := 0.00187041, p_m := 0.48847369, p_s := 0.07773752, active_fold := 4
else if time >= 1789516800000 and time < 1789776000000
    w1 := 0.11045792, w2 := 0.00005835, w3 := -0.11192143, w4 := -0.06003448
    w5 := 0.43437802, w6 := -0.77024441, w7 := -1.06915173, w8 := 0.49417866
    b0 := -0.11591029, p_m := 0.53914168, p_s := 0.14093478, active_fold := 5
else if time >= 1789776000000 and time < 1790035200000
    w1 := 0.04555016, w2 := 0.01184846, w3 := -0.16964472, w4 := -0.11120749
    w5 := 0.44678460, w6 := -0.98248413, w7 := -0.61954503, w8 := 0.46359442
    b0 := -0.16767255, p_m := 0.53976085, p_s := 0.17655267, active_fold := 6
else if time >= 1790035200000 and time < 1790294400000
    w1 := 0.04247617, w2 := 0.02440349, w3 := -0.18090365, w4 := -0.11759113
    w5 := 0.66585375, w6 := -0.83114566, w7 := -0.61411699, w8 := 0.46496438
    b0 := -0.07553418, p_m := 0.50913522, p_s := 0.13672029, active_fold := 7
else if time >= 1790294400000 and time < 1790553600000
    w1 := -0.10561833, w2 := 0.01188268, w3 := -0.12258421, w4 := -0.07535000
    w5 := -1.32628439, w6 := 0.38450953, w7 := -0.23493652, w8 := 0.69109255
    b0 := -0.09472445, p_m := 0.51733968, p_s := 0.13597725, active_fold := 8
else if time >= 1790553600000 and time < 1790812800000
    w1 := -0.08167235, w2 := 0.03516008, w3 := -0.05174238, w4 := -0.08912693
    w5 := -1.26718086, w6 := -0.22148880, w7 := -0.00236668, w8 := 0.26974813
    b0 := -0.15528357, p_m := 0.50251557, p_s := 0.12288416, active_fold := 9
else if time >= 1790812800000 and time < 1791072000000
    w1 := 0.09751762, w2 := 0.00648205, w3 := -0.16370293, w4 := -0.09069950
    w5 := -0.86511660, w6 := 0.23672764, w7 := -0.17695962, w8 := -0.30927340
    b0 := -0.14057065, p_m := 0.52276843, p_s := 0.14163828, active_fold := 10
else if time >= 1791072000000 and time < 1791331200000
    w1 := 0.01337247, w2 := 0.02189219, w3 := -0.07521563, w4 := -0.11074101
    w5 := 0.09033581, w6 := -0.93973111, w7 := -0.09268636, w8 := 0.01930622
    b0 := -0.19425312, p_m := 0.49884511, p_s := 0.12452452, active_fold := 11
else if time >= 1791331200000 and time < 1791590400000
    w1 := 0.12693235, w2 := -0.01408525, w3 := -0.04370100, w4 := -0.07531484
    w5 := 0.22729088, w6 := -1.35251007, w7 := -0.19959494, w8 := 0.07081226
    b0 := -0.11009437, p_m := 0.50171480, p_s := 0.11188531, active_fold := 12
else if time >= 1791590400000 and time < 1791849600000
    w1 := 0.09954636, w2 := -0.00223954, w3 := -0.04478656, w4 := -0.06947695
    w5 := 0.28363489, w6 := -1.46477946, w7 := -0.22034536, w8 := 0.17251945
    b0 := -0.12604761, p_m := 0.49780256, p_s := 0.10587753, active_fold := 13
else if time >= 1791849600000 and time < 1792108800000
    w1 := 0.09412934, w2 := 0.00664927, w3 := -0.02465380, w4 := -0.07983597
    w5 := 0.75451483, w6 := -1.47040626, w7 := 0.07227497, w8 := -0.32966962
    b0 := -0.11255431, p_m := 0.48782295, p_s := 0.12546328, active_fold := 14
else if time >= 1792108800000 and time < 1792368000000
    w1 := -0.12083081, w2 := 0.02589425, w3 := -0.07418501, w4 := -0.03700948
    w5 := 0.64822476, w6 := -1.10105349, w7 := 0.32621260, w8 := 0.66729692
    b0 := -0.02060835, p_m := 0.49833022, p_s := 0.08574092, active_fold := 15
else if time >= 1792368000000 and time < 1792627200000
    w1 := -0.19488006, w2 := 0.01843341, w3 := -0.06910678, w4 := -0.05316606
    w5 := -0.51786920, w6 := -0.34072409, w7 := 0.53929671, w8 := 1.06309210
    b0 := -0.02661996, p_m := 0.50169470, p_s := 0.11852209, active_fold := 16
else if time >= 1792627200000 and time < 1792886400000
    w1 := -0.16976341, w2 := -0.00223376, w3 := -0.06799322, w4 := -0.02699234
    w5 := -0.16143681, w6 := -0.30028482, w7 := 0.48553325, w8 := 0.97878909
    b0 := -0.00096069, p_m := 0.50110816, p_s := 0.08425180, active_fold := 17
else if time >= 1792886400000 and time < 1793145600000
    w1 := -0.26516502, w2 := 0.01389061, w3 := -0.01738769, w4 := -0.02067345
    w5 := -0.10189867, w6 := -0.76089470, w7 := 0.70781220, w8 := 0.95657353
    b0 := -0.00589029, p_m := 0.50213190, p_s := 0.08832077, active_fold := 18
else if time >= 1793145600000 and time < 1793404800000
    w1 := -0.18487443, w2 := -0.00733486, w3 := -0.03497042, w4 := 0.03125199
    w5 := 0.66851501, w6 := -0.76626501, w7 := 0.56529330, w8 := 0.17438494
    b0 := 0.05608985, p_m := 0.50567424, p_s := 0.09614535, active_fold := 19
else if time >= 1793404800000 and time < 1793664000000
    w1 := -0.14652950, w2 := -0.03543547, w3 := -0.03894267, w4 := 0.00718176
    w5 := 0.14125852, w6 := -0.76543733, w7 := 0.40546738, w8 := 0.24404172
    b0 := 0.00675801, p_m := 0.50309815, p_s := 0.09799898, active_fold := 20
else if time >= 1793664000000 and time < 1793923200000
    w1 := -0.16445398, w2 := -0.01538475, w3 := -0.03748024, w4 := -0.00248152
    w5 := 1.29832746, w6 := -0.84824657, w7 := 0.14865337, w8 := 0.17029833
    b0 := 0.04115033, p_m := 0.50594400, p_s := 0.07025194, active_fold := 21
else if time >= 1793923200000 and time < 1794182400000
    w1 := -0.06250752, w2 := 0.01277333, w3 := -0.19984730, w4 := -0.00850268
    w5 := 1.96081680, w6 := -0.65976952, w7 := -0.13503255, w8 := 0.03913026
    b0 := -0.02346720, p_m := 0.50246386, p_s := 0.07595129, active_fold := 22
else if time >= 1794182400000 and time < 1794441600000
    w1 := -0.07794559, w2 := 0.04841829, w3 := -0.13750668, w4 := -0.00914417
    w5 := 1.05639688, w6 := -0.26325348, w7 := -0.06456883, w8 := -0.00313641
    b0 := -0.02774217, p_m := 0.50185638, p_s := 0.04953662, active_fold := 23
else if time >= 1794441600000 and time < 1794700800000
    w1 := -0.07733523, w2 := 0.05090215, w3 := -0.09606479, w4 := -0.04133132
    w5 := 0.36008494, w6 := -0.19026854, w7 := -0.05891394, w8 := 0.11968713
    b0 := -0.01952904, p_m := 0.53355530, p_s := 0.10539859, active_fold := 24
else
    w1 := 0.03237438, w2 := 0.09746197, w3 := -0.14889250, w4 := -0.01511698
    w5 := 0.92669728, w6 := -0.25726171, w7 := -0.46986766, w8 := 0.17530484
    b0 := -0.00384699, p_m := 0.51217141, p_s := 0.06347711, active_fold := 25

logit   = b0 + f1*w1 + f2*w2 + f3*w3 + f4*w4 + f5*w5 + f6*w6 + f7*w7 + f8*w8
raw_p   = 1.0 / (1.0 + math.exp(-logit))
prob_up = 1.0 / (1.0 + math.exp(-((raw_p - p_m) / (p_s * 0.80))))
prob_dn = 1.0 - prob_up

// =========================================================================
// 5. SUB-REGIME EXECUTION ENGINE (ASIAN MEAN-REV VS LONDON/NY TREND)
// =========================================================================
calc_qty(pct_eq) =>
    math.max(0.001, (strategy.equity * (pct_eq / 100.0)) / close)

vol_ok   = (atr_ratio >= min_atr_rat) and (atr_ratio <= 1.85)
shock_ok = (shock_ratio <= max_shock)
gate_ok  = in_date_window and vol_ok and shock_ok

// Sub-Regime A: London / NY Trend & Pullback (07:00 - 20:00 UTC)
lon_ny_short = is_lon_ny and (er12 >= er_min_val) and (close < ema200) and (ema50 < ema200) and (prob_dn >= conf_thresh) and (f6 < 0.15) and (f3 > -2.0)
lon_ny_long  = is_lon_ny and (er12 >= er_min_val) and (close > ema200) and (ema50 > ema200) and (prob_up >= conf_thresh) and (f6 > -0.15) and (f3 < 2.0)

// Sub-Regime B: Asian Session VWAP Mean-Reversion (00:00 - 07:00 UTC, Calm ATR)
asian_short  = (not is_lon_ny) and (atr_ratio <= 1.35) and (er12 >= er_min_val - 0.02) and (close < ema200) and (close > vwap32) and (close < open) and (prob_dn >= conf_thresh - 0.02)
asian_long   = (not is_lon_ny) and (atr_ratio <= 1.35) and (er12 >= er_min_val - 0.02) and (close > ema200) and (close < vwap32) and (close > open) and (prob_up >= conf_thresh - 0.02)

bull_trig = gate_ok and (lon_ny_long or asian_long)
bear_trig = gate_ok and (lon_ny_short or asian_short)

bull_pct  = (lon_ny_long and prob_up >= strong_th) ? 65.0 : 35.0
bear_pct  = (lon_ny_short and prob_dn >= strong_th) ? 65.0 : 35.0

var int   entry_bar  = na
var int   last_loss  = -999
var float init_entry = na
var float entry_atr  = na
var float tp_level   = na
var float sl_level   = na
var bool  scaled_in  = false
var float active_pct = 0.0

if strategy.position_size == 0 and strategy.position_size[1] != 0
    if strategy.closedtrades > 0 and strategy.closedtrades.profit(strategy.closedtrades - 1) < 0
        last_loss := bar_index

cooldown_ok = (bar_index - last_loss) >= 3

if barstate.isconfirmed
    if strategy.position_size == 0 and cooldown_ok
        if bull_trig
            strategy.entry("WF Long", strategy.long, qty=calc_qty(bull_pct), comment="WF BUY (" + str.tostring(bull_pct) + "%) " + str.tostring(math.round(prob_up*100)) + "%")
            entry_bar  := bar_index
            init_entry := close
            entry_atr  := atr14
            tp_level   := close + (atr14 * tp_mult)
            sl_level   := close - (atr14 * sl_mult)
            scaled_in  := false
            active_pct := bull_pct
        else if bear_trig
            strategy.entry("WF Short", strategy.short, qty=calc_qty(bear_pct), comment="WF SELL (" + str.tostring(bear_pct) + "%) " + str.tostring(math.round(prob_dn*100)) + "%")
            entry_bar  := bar_index
            init_entry := close
            entry_atr  := atr14
            tp_level   := close - (atr14 * tp_mult)
            sl_level   := close + (atr14 * sl_mult)
            scaled_in  := false
            active_pct := bear_pct

    else if strategy.position_size > 0 and enable_pyr and not scaled_in
        if (close >= init_entry + entry_atr * 0.50) and (prob_up >= conf_thresh)
            strategy.entry("WF Long Scale", strategy.long, qty=calc_qty(35.0), comment="+Pyramid (35%)")
            scaled_in  := true
            active_pct := active_pct + 35.0
            sl_level   := math.max(sl_level, init_entry)

    else if strategy.position_size < 0 and enable_pyr and not scaled_in
        if (close <= init_entry - entry_atr * 0.50) and (prob_dn >= conf_thresh)
            strategy.entry("WF Short Scale", strategy.short, qty=calc_qty(35.0), comment="+Pyramid (35%)")
            scaled_in  := true
            active_pct := active_pct + 35.0
            sl_level   := math.min(sl_level, init_entry)

if strategy.position_size > 0
    if high >= (init_entry + entry_atr * trail_trig_m)
        sl_level := math.max(sl_level, init_entry + entry_atr * 0.35)
    strategy.exit("Exit Long", from_entry="WF Long", limit=tp_level, stop=sl_level)
    strategy.exit("Exit Long Scale", from_entry="WF Long Scale", limit=tp_level, stop=sl_level)
    if (bar_index - entry_bar) >= horizon_bars
        strategy.close_all(comment="Horizon Exit")
else if strategy.position_size < 0
    if low <= (init_entry - entry_atr * trail_trig_m)
        sl_level := math.min(sl_level, init_entry - entry_atr * 0.35)
    strategy.exit("Exit Short", from_entry="WF Short", limit=tp_level, stop=sl_level)
    strategy.exit("Exit Short Scale", from_entry="WF Short Scale", limit=tp_level, stop=sl_level)
    if (bar_index - entry_bar) >= horizon_bars
        strategy.close_all(comment="Horizon Exit")

if use_date_filter and not in_date_window and strategy.position_size != 0
    strategy.close_all(comment="Window End")

// =========================================================================
// 6. OVERLAYS & WALK-FORWARD TELEMETRY HUD
// =========================================================================
plot(ema200, "1-Hour 50 EMA (Macro Structure)", color=color.new(color.yellow, 10), linewidth=2)
plot(ema50,  "15m EMA 50", color=color.new(color.aqua, 30), linewidth=1)
plot(vwap32, "Session VWAP", color=color.new(color.fuchsia, 25), linewidth=2)

var table hud = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 15), border_width=1)
if barstate.islast
    conf_pct = prob_up >= 0.5 ? math.round(prob_up * 100, 1) : math.round(prob_dn * 100, 1)
    sess_txt = is_lon_ny ? "LONDON/NY (TREND)" : "ASIAN (VWAP REV)"
    reg_txt  = close < ema200 ? "BEARISH (<1H EMA50)" : "BULLISH (>1H EMA50)"
    sig_txt  = not shock_ok ? "PAUSED (MACRO SHOCK)" : bull_trig ? "BUY / LONG" : bear_trig ? "SELL / SHORT" : "WAIT / FILTERED"
    sig_col  = not shock_ok ? color.orange : bull_trig ? color.green : bear_trig ? color.red : color.gray

    table.cell(hud, 0, 0, "ML Methodology", text_color=color.white)
    table.cell(hud, 1, 0, "18d Rolling Walk-Forward (Fold #" + str.tostring(active_fold) + ")", text_color=color.yellow)
    table.cell(hud, 0, 1, "Macro Structure", text_color=color.white)
    table.cell(hud, 1, 1, reg_txt, text_color=close < ema200 ? color.red : color.lime)
    table.cell(hud, 0, 2, "Session Sub-Regime", text_color=color.white)
    table.cell(hud, 1, 2, sess_txt, text_color=color.aqua)
    table.cell(hud, 0, 3, "Volatility vs 5d Avg", text_color=color.white)
    table.cell(hud, 1, 3, str.tostring(math.round(atr_ratio, 2)) + "x (" + (vol_ok ? "ACTIVE" : "PAUSED") + ")", text_color=vol_ok ? color.lime : color.orange)
    table.cell(hud, 0, 4, "AI Conviction", text_color=color.white)
    table.cell(hud, 1, 4, (prob_up >= 0.5 ? "UP " : "DN ") + str.tostring(conf_pct) + "%", text_color=color.white)
    table.cell(hud, 0, 5, "Live Action", text_color=color.white)
    table.cell(hud, 1, 5, sig_txt, bgcolor=sig_col, text_color=color.white)
